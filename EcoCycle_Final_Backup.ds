	reports
	{
		default list Recycling_Tracking_Report
		{
			displayName = "Recycling Tracking Report"
			show all rows from Recycling_Tracking    
			(
				E_Waste_Name as "E-Waste Name"
				Category
				Quantity
				Collection_Date as "Collection Date"
				Recycling_Status as "Recycling Status"
				Recycler_Name as "Recycler Name"
				Remarks
				Recycling_Method as "Recycling Method"
			)
		}
		list All_E_Waste
		{
			displayName = "All E-Waste"
			show all rows from E_Waste_Entry    
			(
				E_Waste_Name as "E-Waste Name"
				Ctae as "Category"
				Quantity
				Age_years as "Age(years)"
				Contains_Hazardous_Material as "Contains Hazardous  Material?"
				Co as "Condition"
				Collection_Location as "Collection Location"
				Contact_Details as "User Name "
				Email
				Phone_Number1 as " Phone Number"
				(
					displayformat = plainnumber 
				)
				Priority_Score as "Priority Score"
				Priority_Level as "Priority Level"
				Collection_Status as "Collection Status"
				Recycling_Status as "Recycling Status"
			)
		}
		list High_Priority_E_Waste
		{
			displayName = "High Priority E-Waste"
			show all rows from E_Waste_Entry  [Priority_Level == "High"]  
			(
				E_Waste_Name as "E-Waste Name"
				Ctae as "Category"
				Quantity
				Age_years as "Age(years)"
				Contains_Hazardous_Material as "Contains Hazardous  Material?"
				Co as "Condition"
				Collection_Location as "Collection Location"
				Contact_Details as "User Name "
				Email
				Phone_Number1 as " Phone Number"
				(
					displayformat = plainnumber 
				)
				Priority_Score as "Priority Score"
				Priority_Level as "Priority Level"
				Collection_Status as "Collection Status"
				Recycling_Status as "Recycling Status"
			)
		}
		list Collection_Requests
