					{
						icon = "shopping-delivery-track"
					}
					report Recycling_Tracking_Report
					{
						icon = "tech-desktop"
					}
				}
				section EcoCycle_Dashboard
				{
					displayname = "EcoCycle Dashboard"
					icon = "ui-1-dashboard-half"
					page EcoCycle_Dashboard
					{
						icon = "ui-1-dashboard-half"
					}
				}
				section AI_Agents
				{
					displayname = "AI Agents"
					icon = "ui-2-chat-content"
					chat EcoCycle_Data_Assistant
					{
						icon = "ui-1-database"
					}
				}
			}
			preference
			{
				icon
				{
					style = outline
				}
			}
		}
