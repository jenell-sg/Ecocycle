	 			column = 0   
				width = medium
			)
			must have E_Waste_Name
			(
    			type = text
				displayname = "E-Waste Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				maxchar = 100
				values = {"Mobile Phone","Laptop","Computer","Monitor","Printer","Television","Battery","Other"}
