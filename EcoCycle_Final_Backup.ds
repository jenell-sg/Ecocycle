		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section E_waste_Entries
				{
					displayname = "E-waste Entries"
					icon = "tech-desktop"
					form  E_Waste_Entry
					{
						icon = "furniture-door"
					}
					report All_E_Waste
					{
						icon = "furniture-door"
					}
					report High_Priority_E_Waste
					{
						icon = "furniture-door"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Collection_Requests
				{
					displayname = "Collection Requests"
					icon = "design-collection"
					form  Collection_Request
					{
						icon = "design-collection"
					}
					report Collection_Requests
					{
						icon = "design-collection"
					}
				}
				section Recycling_Tracking
				{
					displayname = "Recycling Tracking"
					icon = "shopping-delivery-track"
