	pages
	{
		page EcoCycle_Dashboard
		{
			displayname = "EcoCycle Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'ECOCYCLE'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'E-WASTE COLLECTION &amp; RECYCLING DASHBOARD'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='E-Waste Priority Distribution'\n\n\t\n\ttitle = 'E-Waste Priority Distribution'\n\t\n\t\ttitleColor = '#222326'\n\ttype = 'Pie'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'left.center'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'E_Waste_Entry'\n\txfield = 'Priority_Level'\n\tyfields = 'count:Collection_Status'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\t\n\ttitle = 'Collection Request Status'\n\t\n\t\ttitleColor = '#222326'\n\ttype = 'Bar'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Collection_Request'\n\txfield = 'Request_Status'\n\tyfields = 'count:Email'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Recycling Status'\n\t\n\t\ttitleColor = '#222326'\n\ttype = 'Bar'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Recycling_Tracking'\n\txfield = 'Recycling_Status'\n\tyfields = 'count:E_Waste_Name'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\n\ttitle = 'High Priority E-Waste'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'High_Priority_E_Waste'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\n\ttitle = 'Collection Requests'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Collection_Requests'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\n\ttitle = 'Recycling Tracking'\n\t\n\t\ttitleColor = '#222326'\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Recycling_Tracking_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}
	chats
	{
		chat EcoCycle_Data_Assistant
		{
			display name = "EcoCycle Data Assistant"
			access level = read_write
			instructions
			(
				value = "You are an AI assistant for the EcoCycle e-waste management application. Your primary function is to retrieve and analyze data from the E-Waste Entry, Collection Request, and Recycling Tracking modules. You must answer user questions based strictly on the existing application data. You can perform read and write operations on records unless restricted by the user. Do not attempt to create, configure, or manage application forms, workflows, pages, settings, or metadata. Focus solely on providing insights and data retrieval related to e-waste management, collection statuses, and recycling progress."
			)
			personalization
			(
				welcome message = "Hello! I am your EcoCycle Data Assistant. I can help you retrieve information about e-waste entries, collection requests, and recycling tracking. Ask me about high-priority items, request statuses, quantities, or recycling progress."
			)
			forms
			(
				Collection_Request
				E_Waste_Entry
				Recycling_Tracking
			)
		}
	}




		workflow
		{
		form
		{
			Calculate_E_Waste_Priorit as "Calculate E-Waste Priority"
			{
				type =  form
				form = E_Waste_Entry

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											score = 0;
										if(input.Quantity >= 10)
										{
											score = score + 3;
										}
										else if(input.Quantity >= 5)
										{
											score = score + 2;
										}
										if(input.Age_years >= 5)
										{
											score = score + 3;
										}
										else if(input.Age_years >= 3)
										{
											score = score + 2;
										}
										if(input.Contains_Hazardous_Material == "Yes")
										{
											score = score + 4;
										}
										if(input.Co == "Damaged" || input.Co == "Not Working")
										{
											score = score + 1;
										}
										input.Priority_Score = score;
										if(score >= 8)
										{
											input.Priority_Level = "High";
										}
										else if(score >= 4)
										{
											input.Priority_Level = "Medium";
										}
										else
										{
											input.Priority_Level = "Low";
										}
										input.Collection_Status = "Pending";
										input.Recycling_Status = "Not Processed";
						)
					}
				}

			}
			Validate_Collection_Reque as "Validate Collection Request"
			{
				type =  form
				form = Collection_Request

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Preferred_Collection_Date < zoho.currentdate)
										{
											alert "Preferred collection date cannot be in the past.";
											cancel submit;
										}
						)
					}
				}

			}
			Validate_Recycling_Tracki as "Validate Recycling Tracking"
			{
				type =  form
				form = Recycling_Tracking

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											input.Recycling_Status = "Not Processed";
						)
					}
				}

			}
			High_Priority_Notificatio as "High Priority Notification"
			{
				type =  form
				form = E_Waste_Entry

				record event = on add

				on success
				{
					actions  (Priority_Level == "High")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "jenell.sg.2024.cse@rajalakshmi.edu.in"
							subject : "High Priority E-Waste Alert - EcoCycle"
							message : "<div>A high-priority e-waste record has been submitted in EcoCycle. <br></div><div><br></div><div>Please review the record and arrange collection if required.<br></div><div><br></div><div>Priority: High<br></div>"
							content type : Plain Text
						)
					}
				}

			}
		}






	}
	share_settings
	{
