 application "EcoCycle"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Collection_Request
		{
			displayname = "Collection Request"
			success message = "Collection Request Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Requester_Name
			(
    			type = text
				displayname = "Requester Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Phone_Number1
			(
    			type = phonenumber
				displayname = " Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Collection_Location
			(
    			type = text
				displayname = "Collection Location"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have E_Waste_Category
			(
				type = picklist
				displayname = "E-Waste Category"
				maxchar = 100
				values = {"Mobile Phone","Laptop","Computer","Monitor","Printer","Television","Battery","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Preferred_Collection_Date
			(
    			type = date
				displayname = "Preferred Collection Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Preferred_Time
			(
				type = picklist
				displayname = "Preferred Time"
				maxchar = 100
				values = {"Morning","Afternoon","Evening"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Request_Status
			(
				type = picklist
				displayname = "Request Status"
				maxchar = 100
				values = {"Pending","Approved","Scheduled","Collected","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Collection_Completed_Date
			(
    			type = date
				displayname = "Collection Completed Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form E_Waste_Entry
		{
			displayname = "E-Waste Entry"
			success message = "E-waste Entry Added Successfully"
			Section
			(
